# Must match what Phase 1 produced
INDEX_PATH=data/artifacts_v2/catalog.faiss
IDS_PATH=data/artifacts_v2/index_product_ids.npy
CATALOG_PATH=data/raw/catalog.jsonl
# Must be the SAME CLIP model used by the `embed` stage
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
# Leave empty to use the in-memory cache
REDIS_URL=
CACHE_TTL_SECONDS=300
MAX_UPLOAD_MB=5
ZERO_SHOT_CATEGORIES=1
# Comma-separated browser origins; keep localhost for local frontend development
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
